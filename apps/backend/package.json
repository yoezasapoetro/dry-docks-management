{
  "name": "@limin/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts",
    "db:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/db/data-source.ts",
    "db:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/db/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@limin/demo-module": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "mysql2": "^3.24.5",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "0.11.3",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}