# Container configuration, externalised per AC-01 (no hand-editing compose files).
# Values here are read by docker-compose.apps.yml via env_file and by the
# backend composition root at startup.

DATABASE_URL=mysql://woms:woms@localhost:3306/woms
DATABASE_POOL_SIZE=10

# Local development targets SeaweedFS S3 gateway; production targets AWS S3.
# The only differences are these values (AC-06, R-007).
OBJECT_STORE_ENDPOINT=http://localhost:8333
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_FORCE_PATH_STYLE=true
OBJECT_STORE_BUCKET=woms-local
OBJECT_STORE_KEY_PREFIX=local/
OBJECT_STORE_ACCESS_KEY_ID=woms-local-access
OBJECT_STORE_SECRET_ACCESS_KEY=woms-local-secret

HTTP_PORT=3000
LOG_LEVEL=info
CONTRACT_VERSION=1.0.0